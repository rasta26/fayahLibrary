#!/usr/bin/env bash
# fayahLibrary installer
#   ./install                  the three job plugins + default MCP servers
#   ./install --mcp NAME       add one optional MCP server from shared/mcp.json
#   ./install --scan           run SkillSpector over this repo (also: make scan)
#   ./install --uninstall      remove plugins + symlink fallback
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAYAH_HOME="${FAYAH_HOME:-$HOME/.fayah}"
MARKET="fayah-library"
# plugin name:folder, one per job
PLUGINS=("fayah-review:code-review" "fayah-coaching:coaching" "fayah-delivery:delivery")
LEGACY_PLUGIN="fayah-core"
MCP_FILE="$ROOT/shared/mcp.json"

say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1 ($2)"; }

# ---------- SkillSpector gate ----------
scan() {
  if ! command -v skillspector >/dev/null 2>&1; then
    say "SkillSpector not found; installing (pip)"
    python3 -m pip install --user -q skillspector 2>/dev/null \
      || pipx install skillspector 2>/dev/null \
      || die "could not install skillspector; see https://github.com/NVIDIA/SkillSpector"
  fi
  say "Scanning skills, agents, commands and MCP config"
  local rc=0
  for p in "${PLUGINS[@]}"; do
    skillspector scan "$ROOT/${p#*:}" || rc=$?
  done
  skillspector scan "$MCP_FILE" || rc=$?
  if [ "$rc" -ne 0 ]; then
    die "SkillSpector reported findings (exit $rc). Fix or baseline before committing. Report: .skillspector-report.json"
  fi
  say "SkillSpector: clean"
}

# ---------- core plugin ----------
install_plugin() {
  need claude "install Claude Code first: https://docs.claude.com/en/docs/claude-code"
  say "Registering marketplace '$MARKET' from $ROOT"
  if claude plugin marketplace add "$ROOT" >/dev/null 2>&1 || claude plugin marketplace update "$MARKET" >/dev/null 2>&1; then
    claude plugin uninstall "$LEGACY_PLUGIN@$MARKET" >/dev/null 2>&1 || true
    for p in "${PLUGINS[@]}"; do
      say "Installing plugin ${p%%:*}@$MARKET"
      claude plugin install "${p%%:*}@$MARKET" --scope user || { warn "plugin install returned non-zero; falling back to symlinks"; symlink_fallback; return; }
    done
  else
    warn "claude plugin marketplace commands unavailable; falling back to symlinks"
    symlink_fallback
  fi
}

symlink_fallback() {
  for p in "${PLUGINS[@]}"; do
    local src="$ROOT/${p#*:}"
    for kind in skills agents commands; do
      mkdir -p "$HOME/.claude/$kind"
      for item in "$src/$kind"/*; do
        [ -e "$item" ] || continue
        ln -sfn "$item" "$HOME/.claude/$kind/$(basename "$item")"
      done
    done
  done
  say "Symlinked skills/agents/commands into ~/.claude"
}

uninstall() {
  claude plugin uninstall "$LEGACY_PLUGIN@$MARKET" 2>/dev/null || true
  for p in "${PLUGINS[@]}"; do
    claude plugin uninstall "${p%%:*}@$MARKET" 2>/dev/null || true
    for kind in skills agents commands; do
      for item in "$ROOT/${p#*:}/$kind"/*; do
        [ -e "$item" ] || continue
        local link="$HOME/.claude/$kind/$(basename "$item")"
        [ -L "$link" ] && rm -f "$link"
      done
    done
  done
  claude plugin marketplace remove "$MARKET" 2>/dev/null || true
  say "Removed fayahLibrary plugins"
}

# ---------- MCP servers ----------
mcp_add() {
  local name="$1"
  need jq "apt/brew install jq"
  local entry; entry="$(jq -c --arg n "$name" '.servers[$n] // empty' "$MCP_FILE")"
  [ -n "$entry" ] || die "no MCP server named '$name' in shared/mcp.json"
  # prompt for empty env vars
  local envargs=()
  for key in $(printf '%s' "$entry" | jq -r '(.env // {}) | keys[]'); do
    local val; val="$(printf '%s' "$entry" | jq -r --arg k "$key" '.env[$k]')"
    if [ -z "$val" ]; then
      val="${!key:-}"
      if [ -z "$val" ]; then
        read -r -s -p "  $key for $name (leave blank to skip server): " val; echo
        [ -n "$val" ] || { warn "skipped $name"; return 0; }
      fi
    fi
    envargs+=(-e "$key=$val")
  done
  local cmd; cmd="$(printf '%s' "$entry" | jq -r '.command')"
  mapfile -t args < <(printf '%s' "$entry" | jq -r '.args[]')
  say "MCP: adding $name"
  claude mcp remove "$name" --scope user >/dev/null 2>&1 || true
  claude mcp add --scope user "${envargs[@]}" "$name" -- "$cmd" "${args[@]}"
}

mcp_defaults() {
  need jq "apt/brew install jq"
  for n in $(jq -r '.servers | to_entries[] | select(.value.default) | .key' "$MCP_FILE"); do
    mcp_add "$n"
  done
}

# ---------- main ----------
case "${1:-}" in
  "")            install_plugin; mcp_defaults
                 say "Done. Restart Claude Code, then try /cleanup-audit, /spec, /orchestrate, /review, /kata, /add-tracking" ;;
  --mcp)         [ -n "${2:-}" ] || die "usage: ./install --mcp NAME"; mcp_add "$2" ;;
  --scan)        scan ;;
  --uninstall)   uninstall ;;
  -h|--help)     sed -n "2,6p" "$0" ;;
  *)             die "unknown option $1 (try --help)" ;;
esac
