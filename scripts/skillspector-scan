#!/usr/bin/env bash
# SkillSpector gate: one source of truth for how this repo installs and runs
# NVIDIA SkillSpector. Used by `./install --scan`, `make scan`, the pre-commit
# hook and .github/workflows/scan.yml.
#
#   scripts/skillspector-scan install             install the pinned release if missing
#   scripts/skillspector-scan [--format F] [--out DIR]
#                                                 scan every target; F = terminal|json|markdown|sarif
#
# Install follows upstream (https://github.com/NVIDIA/skillspector#installation):
# SkillSpector is installed from Git, not PyPI. Pinned to a release commit so a
# moved tag or a look-alike package can't change what the gate runs.
#
# Exit: 0 clean, 1 findings (or incomplete coverage on strict targets), 2 scanner error (worst wins).
# LLM analysis runs only when SKILLSPECTOR_PROVIDER is set; otherwise --no-llm.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SKILLSPECTOR_VERSION="2.13.5"
SKILLSPECTOR_COMMIT="9ffc3028df0ca6bbe52113e7820805d100f6f6f4" # tag v2.13.5
SKILLSPECTOR_SRC="git+https://github.com/NVIDIA/skillspector.git@${SKILLSPECTOR_COMMIT}"
BASELINE="${SKILLSPECTOR_BASELINE:-$ROOT/.skillspector-baseline.yaml}"

# name | path (relative to ROOT) | extra scan args
# --fail-on-incomplete is per target: the plugin ships a command hook that runs a
# script, whose payload SkillSpector never models statically, so that target is
# always "partial" by design. It still fails on any finding not in the baseline.
TARGETS=(
  "skills|plugins/fayah-core/skills|--recursive --fail-on-incomplete"
  "plugin|plugins/fayah-core|"
  "mcp|mcp/servers.json|--fail-on-incomplete"
)

say()  { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 2; }

installed_version() {
  command -v skillspector >/dev/null 2>&1 || return 1
  skillspector --version 2>/dev/null | sed -n 's/.*v\([0-9][0-9.]*\).*/\1/p'
}

install_skillspector() {
  if [ "$(installed_version || true)" = "$SKILLSPECTOR_VERSION" ]; then
    say "SkillSpector v$SKILLSPECTOR_VERSION already installed"
    return 0
  fi
  say "Installing SkillSpector v$SKILLSPECTOR_VERSION from $SKILLSPECTOR_SRC"
  if command -v uv >/dev/null 2>&1; then
    uv tool install --force --python 3.12 "skillspector @ $SKILLSPECTOR_SRC"
  elif command -v pipx >/dev/null 2>&1; then
    pipx install --force "skillspector @ $SKILLSPECTOR_SRC"
  else
    die "install uv (https://docs.astral.sh/uv/) or pipx, then re-run"
  fi
  [ "$(installed_version || true)" = "$SKILLSPECTOR_VERSION" ] \
    || die "skillspector v$SKILLSPECTOR_VERSION not on PATH after install (is ~/.local/bin on PATH?)"
}

scan_all() {
  local format="$1" out="$2"
  command -v skillspector >/dev/null 2>&1 || die "skillspector not installed; run: $0 install"

  local common=(--fail-on-findings)
  [ -n "${SKILLSPECTOR_PROVIDER:-}" ] || common+=(--no-llm)
  [ -f "$BASELINE" ] && common+=(--baseline "$BASELINE")

  [ "$format" = terminal ] || mkdir -p "$out"
  local worst=0 entry name path extra rc ext
  for entry in "${TARGETS[@]}"; do
    IFS='|' read -r name path extra <<<"$entry"
    local args=(scan "$ROOT/$path" "${common[@]}" --format "$format")
    [ -n "$extra" ] && read -ra x <<<"$extra" && args+=("${x[@]}")
    if [ "$format" != terminal ]; then
      case "$format" in markdown) ext=md ;; *) ext="$format" ;; esac
      args+=(--output "$out/$name.$ext")
    fi
    say "scan $name: $path"
    rc=0; skillspector "${args[@]}" || rc=$?
    case "$rc" in
      0) say "$name: clean" ;;
      1) say "$name: findings or incomplete coverage" ;;
      *) say "$name: scanner error (exit $rc)" ;;
    esac
    [ "$rc" -gt "$worst" ] && worst=$rc
  done
  return "$worst"
}

main() {
  if [ "${1:-}" = install ]; then install_skillspector; return; fi
  local format=terminal out="$ROOT/skillspector-results"
  while [ $# -gt 0 ]; do
    case "$1" in
      --format) format="${2:?}"; shift 2 ;;
      --out)    out="${2:?}"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  case "$format" in terminal|json|markdown|sarif) ;; *) die "bad --format: $format" ;; esac
  scan_all "$format" "$out"
}

main "$@"
